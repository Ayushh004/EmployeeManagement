{
  "info": {
    "name": "Employee Management API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Add Employee",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"John Doe\",\n  \"email\": \"john.doe@example.com\",\n  \"department\": \"Engineering\",\n  \"salary\": 55000\n}"
        },
        "url": {
          "raw": "http://localhost:8080/api/employees",
          "protocol": "http",
          "host": ["localhost"],
          "port": "8080",
          "path": ["api", "employees"]
        }
      }
    },
    {
      "name": "Get All Employees (Paginated)",
      "request": {
        "method": "GET",
        "url": {
          "raw": "http://localhost:8080/api/employees?page=0&size=5",
          "protocol": "http",
          "host": ["localhost"],
          "port": "8080",
          "path": ["api", "employees"],
          "query": [
            { "key": "page", "value": "0" },
            { "key": "size", "value": "5" }
          ]
        }
      }
    },
    {
      "name": "Get Employee By ID",
      "request": {
        "method": "GET",
        "url": {
          "raw": "http://localhost:8080/api/employees/1",
          "protocol": "http",
          "host": ["localhost"],
          "port": "8080",
          "path": ["api", "employees", "1"]
        }
      }
    },
    {
      "name": "Update Employee",
      "request": {
        "method": "PUT",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"John Updated\",\n  \"email\": \"john.updated@example.com\",\n  \"department\": \"Marketing\",\n  \"salary\": 60000\n}"
        },
        "url": {
          "raw": "http://localhost:8080/api/employees/1",
          "protocol": "http",
          "host": ["localhost"],
          "port": "8080",
          "path": ["api", "employees", "1"]
        }
      }
    },
    {
      "name": "Delete Employee",
      "request": {
        "method": "DELETE",
        "url": {
          "raw": "http://localhost:8080/api/employees/1",
          "protocol": "http",
          "host": ["localhost"],
          "port": "8080",
          "path": ["api", "employees", "1"]
        }
      }
    },
    {
      "name": "Search Employee By Name",
      "request": {
        "method": "GET",
        "url": {
          "raw": "http://localhost:8080/api/employees/search?name=john",
          "protocol": "http",
          "host": ["localhost"],
          "port": "8080",
          "path": ["api", "employees", "search"],
          "query": [
            { "key": "name", "value": "john" }
          ]
        }
      }
    }
  ]
}
